{#- granite_output_dir(config): the run-script block every granite-evals family
    template shares (steps/eval/<family>/skypilot): the HF cache and warm-cache
    env, the options read once as words (OPT_WORDS, never globbed), and the
    composed, created $OUTPUT_DIR. After an edit, re-run make publish-step in
    all eleven (CI's test_published_steps_match_their_templates.py fails until
    then). -#}
{%- macro granite_output_dir(config) -%}
{#- hf_offline is a word, not a Jinja truth value ("0" and "false" are
    non-empty strings): 1/true/yes/on turn it on, empty/0/false/no/off leave
    it off, anything else fails the run. -#}
{%- set offline_word = (config.hf_offline | string | trim | lower) if config.hf_offline is not none else "" -%}
{%- set offline = offline_word in ("1", "true", "yes", "on") -%}
{% if config.hf_home %}export HF_HOME="{{ config.hf_home }}"; mkdir -p "$HF_HOME"{% endif %}
{% if offline_word not in ("", "0", "false", "no", "off", "1", "true", "yes", "on") %}echo "granite: hf_offline must be 1, true, yes or on (offline), or empty, 0, false, no or off" >&2; exit 1{% endif %}
{% if offline and not config.hf_home %}echo "granite: hf_offline needs hf_home pointing at a cache warmed by make -C steps/eval prefetch" >&2; exit 1{% endif %}
{% if offline %}export HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1  # warm-cache mode: hub reads hit HF_HOME's cache only, never the hub{% endif %}

# options, split on whitespace (no quoting) and never glob-expanded: read -a
# over a single-quoted word, not an unquoted for, so a * or ? in a value (a
# tasks= pattern) stays literal here and in the harness call below.
read -r -a OPT_WORDS <<< '{{ config.options | replace("'", "'\"'\"'") }}'

OUTPUT_DIR="{{ config.output_dir }}"
OUTPUT_ROOT="{{ config.output_root }}"
RUN_NAME="{{ config.run_name }}"
# run_name defaults to the model_path basename (the same defaulting as
# served_model_name), so one output_root serves every model.
if [ -z "$RUN_NAME" ]; then RUN_NAME="$(basename "{{ config.model_path }}")"; fi
# The generic bridges run many benchmarks through one id, so a run that
# selects (a selection option, or a dataset-pinned bridge's dataset) gets
# its own dir, named after EVERY selection value, so two runs that select
# differently never share a dir (results.json would overwrite):
#   <id>@<key>-<value>[@<key>-<value>...]
# in a fixed key order (the options below, then a dataset-pinned bridge's
# dataset and dataset_revision), e.g. lm-eval@tasks-hellaswag,
# tau3@domains-airline+2Cretail, mcpmark@service-filesystem@task_suite-easy.
# The @ keeps it apart from every curated id's dir (no id has one), so a
# bridge run never lands in a curated recipe's dir. A repeated key takes its
# last value, as the harness reads it. No key contains a -, so the first -
# ends the key. Each value is escaped into ONE path segment: [A-Za-z0-9._-]
# stay, any other byte (a /, a comma, a @, a + itself) becomes +XX (hex), so
# distinct values stay distinct. Every character of the name is one a Hydra
# override value takes unquoted (NeMo-Skills passes paths as
# ++output_file=<path>; = , ~ and the like break its parser or make a sweep),
# none is special to a shell glob, and there is no %, which URI handling
# could decode. A name over 200 bytes keeps its first 180 and appends @h-
# and 16 hex of its sha256 (h is no key). With no selection the dir is the
# benchmark id, as for every curated benchmark.
granite_enc() {
  # byte by byte (LC_ALL=C); no length expansions, whose brace-hash would
  # open a Jinja comment in this template
  local LC_ALL=C s="$1" out="" c
  while [ -n "$s" ]; do
    c="${s:0:1}"; s="${s:1}"
    case "$c" in
      [A-Za-z0-9._-]) out="$out$c" ;;
      *) printf -v c '%d' "'$c"; out="$out$(printf '+%02X' $((c & 255)))" ;;
    esac
  done
  printf '%s' "$out"
}
SEL=""
for key in benchmark service task_suite domains categories tasks exclude instances split; do
  found=""
  for kv in "${OPT_WORDS[@]}"; do
    case "$kv" in "$key"=*) found=1; val="${kv#*=}" ;; esac
  done
  if [ -n "$found" ]; then SEL="$SEL@$key-$(granite_enc "$val")"; fi
done
{% if config.dataset and config.benchmark in ("swebench", "terminal-bench", "nemoskills") %}
SEL="$SEL@dataset-$(granite_enc "{{ config.dataset }}")@dataset_revision-$(granite_enc "{{ config.dataset_revision }}")"
{% endif %}
BENCH_DIR="$BENCHMARK$SEL"
if [ "$(printf '%s' "$BENCH_DIR" | wc -c)" -gt 200 ]; then
  h="$(printf '%s' "$BENCH_DIR" | { sha256sum 2>/dev/null || shasum -a 256; } | cut -c1-16)"
  BENCH_DIR="${BENCH_DIR:0:180}@h-$h"
fi
# Either a full output_dir, or output_root composed per benchmark; with
# neither set, fail here rather than deep inside a harness.
if [ -z "$OUTPUT_DIR" ]; then
  if [ -z "$OUTPUT_ROOT" ]; then
    echo "granite: set output_root (the run writes \$OUTPUT_ROOT/\$RUN_NAME/\$BENCH_DIR) or output_dir" >&2
    exit 1
  fi
  OUTPUT_DIR="$OUTPUT_ROOT/$RUN_NAME/$BENCH_DIR"
fi
case "$OUTPUT_DIR" in /*) ;; *) OUTPUT_DIR="${GB_BUILD_WORKDIR:-$PWD}/$OUTPUT_DIR" ;; esac
mkdir -p "$OUTPUT_DIR"
{%- endmacro %}
