{#- granite_output_dir(config): the run-script block every granite-evals family
    template shares (steps/eval/<family>/skypilot): the HF cache and warm-cache
    env, the options read once as words (OPT_WORDS, never globbed), and the
    composed, created $OUTPUT_DIR. After an edit, re-run make publish-step in
    all eleven (CI's test_published_steps_match_their_templates.py fails until
    then). -#}
{%- macro granite_output_dir(config) -%}
{#- hf_offline is a word, not a Jinja truth value ("0" and "false" are
    non-empty strings): 1/true/yes/on turn it on, empty/0/false/no/off leave
    it off, anything else fails the run. -#}
{%- set offline_word = (config.hf_offline | string | trim | lower) if config.hf_offline is not none else "" -%}
{%- set on_words = ("1", "true", "yes", "on") -%}
{%- set off_words = ("", "0", "false", "no", "off") -%}
{%- set offline = offline_word in on_words -%}
{% if config.hf_home %}export HF_HOME="{{ config.hf_home }}"; mkdir -p "$HF_HOME"{% endif %}
{% if offline_word not in on_words and offline_word not in off_words %}echo "granite: hf_offline must be 1, true, yes or on (offline), or empty, 0, false, no or off" >&2; exit 1{% endif %}
{% if offline and not config.hf_home %}echo "granite: hf_offline needs hf_home pointing at a cache warmed by make -C steps/eval prefetch" >&2; exit 1{% endif %}
{% if offline %}export HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1  # warm-cache mode: hub reads hit HF_HOME's cache only, never the hub{% endif %}

# options, split on whitespace (no quoting) and never glob-expanded: read -a
# over a single-quoted word, not an unquoted for, so a * or ? in a value (a
# tasks= pattern) stays literal here and in the harness call below. -d ''
# reads past newlines (a YAML block scalar spreads options over lines; plain
# read -a keeps only the first); it then returns 1 at the end of input. A CR
# (CRLF lines) separates words too.
IFS=$' \t\r\n' read -r -d '' -a OPT_WORDS <<< '{{ config.options | replace("'", "'\"'\"'") }}' || true

OUTPUT_DIR="{{ config.output_dir }}"
OUTPUT_ROOT="{{ config.output_root }}"
RUN_NAME="{{ config.run_name }}"
# run_name defaults to the model_path basename (the same defaulting as
# served_model_name), so one output_root serves every model.
if [ -z "$RUN_NAME" ]; then RUN_NAME="$(basename "{{ config.model_path }}")"; fi
# A run is named after everything in it that can change its results, so two
# runs that differ never share a dir (results.json would overwrite, and a
# resume would mix their caches):
#   <id>@<key>-<value>[@<key>-<value>...]
# First the selection options in a fixed key order (SELECTION below), then
# the data (dataset and dataset_revision, when either is set: a bridge's
# required pin or a curated id's swap), then every other option, sorted by
# key -- protocol options such as lm-eval's mode, num_fewshot, gen_kwargs,
# thinking and metric, sampling, agent and judge settings. Only the
# operational options in OPERATIONAL (retries, timeouts of a request, the
# failure threshold, endpoint addresses, worker counts) leave the name
# alone. E.g. lm-eval@tasks-hellaswag, tau3@domains-airline+2Cretail,
# mcpmark@service-filesystem@task_suite-easy, lm-eval@tasks-gsm8k@thinking-on.
# The @ keeps it apart from every curated id's dir (no id has one). A
# repeated key takes its last value, as the harness reads it. A key is
# escaped like a value and its - becomes +2D, so the first - ends the key.
# Each value is escaped into ONE path segment: [A-Za-z0-9._-] stay, any
# other byte (a /, a comma, a @, a + itself) becomes +XX (hex), so distinct
# values stay distinct. Every character of the name is one a Hydra override
# value takes unquoted (NeMo-Skills passes paths as ++output_file=<path>;
# = , ~ and the like break its parser or make a sweep), none is special to
# a shell glob, and there is no %, which URI handling could decode. A name
# over 200 bytes keeps its first 180 and appends @h- and 16 hex of its
# sha256 (h is no key). With none of these the dir is the benchmark id.
granite_enc() {
  # byte by byte (LC_ALL=C); no length expansions, whose brace-hash would
  # open a Jinja comment in this template
  local LC_ALL=C s="$1" out="" c
  while [ -n "$s" ]; do
    c="${s:0:1}"; s="${s:1}"
    case "$c" in
      [A-Za-z0-9._-]) out="$out$c" ;;
      *) printf -v c '%d' "'$c"; out="$out$(printf '+%02X' $((c & 255)))" ;;
    esac
  done
  printf '%s' "$out"
}
granite_val() {
  # the last value of option $1, and 0 if it is set (the harness reads the last)
  local kv found=1
  GRANITE_VAL=""
  for kv in "${OPT_WORDS[@]}"; do
    case "$kv" in "$1"=*) found=0; GRANITE_VAL="${kv#*=}" ;; esac
  done
  return $found
}
SELECTION=" benchmark service task_suite task_split domains categories tasks exclude instances split "
OPERATIONAL=" max_failed_frac max_retries retry_delay request_timeout grade_workers comet_batch_size judge_base_url search_mcp_url critpt_api_url critpt_api_key_env "
SEL=""
for key in $SELECTION; do
  if granite_val "$key"; then SEL="$SEL@$key-$(granite_enc "$GRANITE_VAL")"; fi
done
{% if config.dataset or config.dataset_revision %}
SEL="$SEL@dataset-$(granite_enc "{{ config.dataset }}")@dataset_revision-$(granite_enc "{{ config.dataset_revision }}")"
{% endif %}
KEYS="$(for kv in "${OPT_WORDS[@]}"; do case "$kv" in (?*=*) printf '%s\n' "${kv%%=*}" ;; esac; done | LC_ALL=C sort -u)"
while IFS= read -r key; do
  [ -n "$key" ] || continue
  case "$SELECTION$OPERATIONAL" in (*" $key "*) continue ;; esac
  granite_val "$key"
  k="$(granite_enc "$key")"
  SEL="$SEL@${k//-/+2D}-$(granite_enc "$GRANITE_VAL")"
done <<< "$KEYS"
BENCH_DIR="$BENCHMARK$SEL"
if [ "$(printf '%s' "$BENCH_DIR" | wc -c)" -gt 200 ]; then
  h="$(printf '%s' "$BENCH_DIR" | { sha256sum 2>/dev/null || shasum -a 256; } | cut -c1-16)"
  BENCH_DIR="${BENCH_DIR:0:180}@h-$h"
fi
# Either a full output_dir, or output_root composed per benchmark; with
# neither set, fail here rather than deep inside a harness.
if [ -z "$OUTPUT_DIR" ]; then
  if [ -z "$OUTPUT_ROOT" ]; then
    echo "granite: set output_root (the run writes \$OUTPUT_ROOT/\$RUN_NAME/\$BENCH_DIR) or output_dir" >&2
    exit 1
  fi
  OUTPUT_DIR="$OUTPUT_ROOT/$RUN_NAME/$BENCH_DIR"
fi
case "$OUTPUT_DIR" in /*) ;; *) OUTPUT_DIR="${GB_BUILD_WORKDIR:-$PWD}/$OUTPUT_DIR" ;; esac
mkdir -p "$OUTPUT_DIR"
{%- endmacro %}
