    "export NCCL_IB_HCA='mlx5_0,mlx5_1'",
    "export NCCL_SOCKET_IFNAME='eth0'",
    "# \u2500\u2500 W&B: rendered only when wandb.project is set \u2500\u2500",
    "export WANDB_PROJECT='g4-pretrain'",
    "export WANDB_MODE='online'",
    "export WANDB_NAME='g4-350m'",
    "export WANDB_ENTITY='granite'",
    "bash ./src/run_pretrain.sh"
  ],
