{
  "single_node_train": [
    "# \u2500\u2500 what the job is \u2500\u2500",
    "export TRAIN_DIR='/shared/runs/g4-350m/train'",
    "export LME_PHASE='train'",
    "export LME_KNOBS_JSON='{\"experiment\": \"g4-350m\", \"max_steps\": 4000}'",
    "export LME_RUNGS=''",
    "export LME_EMIT='false'",
    "export LME_WATCH_INTERVAL='60'",
    "export LME_RESUME_SRC=''",
    "export LME_REQUIRE_PROGRESS='true'",
    "# retry_workload relaunches into the same per-run workdir, so the file",
    "# handshakes under the build-stable train_dir need a name that changes per",
    "# attempt. GB_SKYPILOT_CLUSTER_NAME carries the relaunch counter",
    "# (gb-...-r<attempt>, skypilot.py _cluster_name_for); GB_TARGETRUN_ID and",
    "# GB_SKYPILOT_LAUNCH_ID are replayed unchanged and cannot tell two attempts",
    "# apart. Every node of one attempt reads the same value, which is the point.",
    "export GB_ATTEMPT_TOKEN=\"$(printf '%s' \"${GB_SKYPILOT_CLUSTER_NAME:-${GB_SKYPILOT_LAUNCH_ID:-local}}\" | tr -c 'A-Za-z0-9._-' '_')\"",
    "# \u2500\u2500 code facts: this step's defaults, the same on every cluster \u2500\u2500",
    "export NCCL_TIMEOUT=10800000",
    "export CUDA_DEVICE_MAX_CONNECTIONS=1",
    "export PYTORCH_ALLOC_CONF=expandable_segments:True",
    "export OMP_NUM_THREADS=1",
    "export TOKENIZERS_PARALLELISM=false",
    "export TRITON_CACHE_DIR=/tmp/triton",
    "export HOME=/tmp",
    "export NCCL_IGNORE_CPU_AFFINITY=1",
    "export NCCL_SOCKET_NTHREADS=2",
    "export CUDA_DEVICE_ORDER=PCI_BUS_ID",
    "export CUDA_MODULE_LOADING=LAZY",
    "export NCCL_ALGO=Ring",
    "export NCCL_DEBUG='WARN'",
    "# One node: there is no inter-node traffic to route, so InfiniBand is",
    "# turned off and the cluster's nccl_env is not applied.",
    "export NCCL_IB_DISABLE=1",
    "bash ./src/run_pretrain.sh"
  ],
