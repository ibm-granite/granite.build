# Generated deployable step bundles produced by `make step`.
# The source of truth is step-template.yaml + src/; the bundle dir is derived.
#
# The bundle dir is named after the step (common.mk's STEP_DIR default), e.g.
# byoc/skypilot/byoc/ or eval/skypilot/eval/ — not a fixed literal like the old
# `step/`, so we can't glob it by name. Instead ignore every generated
# subdirectory at the steps/<step>/<env>/<bundle>/ depth, then re-include the one
# source subdirectory that legitimately lives there: src/.
*/*/*/
!*/*/src/
