# Dev-only: loaded by `next dev`, NOT by `next build`. Keeps the dev API proxy
# (see next.config.ts rewrites) working without baking localhost URLs into the
# standalone production bundle. Standalone relies on gbserver serving/proxying
# same-origin /api/* and /api/autotunex/* instead.
GBSERVER_API_URL=http://127.0.0.1:8080
AUTOTUNEX_API_URL=http://localhost:8000
