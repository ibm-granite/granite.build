# gb-ui — root environment variables
# Copy to .env and fill in values before running.
#
# Usage:
#   cp .env.example .env
#   yarn dev      # Next.js on :3000
#   # and optionally: cd server && python -m gb_ui_backend

# ── Frontend ──────────────────────────────────────────────────────────────────

# Environment profile — sets default gbserver URL and auth provider.
# STANDALONE | EXTERNAL | DEV | STAGING | PROD | PROD_INTERNAL
APP_ENVIRONMENT=STANDALONE

# Auth provider for the active environment: apikey (default) | github | ibmid
APP_AUTH_PROVIDER=apikey

# GitHub OAuth App credentials (required when APP_AUTH_PROVIDER=github)
# Register at: github.com/settings/developers → OAuth Apps → New OAuth App
# Set APP_GITHUB_URL to your GitHub Enterprise base URL (defaults to github.com).
APP_GITHUB_CLIENT_ID=
APP_GITHUB_URL=

# Available environments shown in the switcher (server-only — safe for K8s ConfigMap runtime injection).
# JSON array of { "id": "string", "label": "string", "url": "string", "dbSchema": "optional_schema" }.
# If unset, defaults to single Standalone mode (localhost:8080, no switcher shown).
#
# Example — two custom environments:
# ENVIRONMENTS_JSON=[{"id":"DEV","label":"Development","url":"https://dev.example.com","dbSchema":"dev_schema"},{"id":"PROD","label":"Production","url":"https://prod.example.com","dbSchema":"prod_schema"}]
ENVIRONMENTS_JSON=

# GitHub OAuth App client secret (private — server only, never NEXT_PUBLIC_ prefix).
# Callback URL must exactly match the one registered in your GitHub App settings.
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://localhost:3000/auth/trampoline

# ── IBMid OIDC (required when APP_AUTH_PROVIDER=ibmid) ───────────────────────
# Register at: https://developer.ibm.com/
# IBMID_CLIENT_ID=
# IBMID_CLIENT_SECRET=
# IBMID_CALLBACK_URL=http://localhost:8090/api/analytics/auth/ibmid/callback

# ── Server: gbserver connection ───────────────────────────────────────────────
# URL of gbserver, as seen by the server process (not the browser).
# Standalone default (localhost:8080) is used when this is unset.
GB_UI_GBSERVER_URL=http://localhost:8080

# ── Server: gbserver database (optional, enhances analytics and AI analysis) ──
# Connect to gbserver's own SQLite or PostgreSQL for richer analytics.
# Standalone: sqlite+aiosqlite:///~/.llmb/llmb-server.db
# Hosted: postgresql+asyncpg://user:pass@host/db
GB_UI_GBSERVER_DB_URL=
GB_UI_GBSERVER_DB_SCHEMA=public

# ── Server: analytics database ────────────────────────────────────────────────
# Sidecar PostgreSQL — enables leaderboard, K8s resources, AI analysis storage.
# Leave empty when running locally without Docker/Postgres.
# For Docker Compose: postgresql+asyncpg://gbui:gbui@postgres:5432/gbui
GB_UI_DATABASE_URL=

# ── Server: cloud logs (required for Build Logs tab on running builds) ────────
# Without this, the Logs tab only shows logs for completed steps.
GB_UI_CLOUD_LOGS_URL=
GB_UI_CLOUD_LOGS_API_KEY=

# ── AI failure analysis (optional) ───────────────────────────────────────────
# Set GB_UI_AI_ANALYSIS_ENABLED=true to enable background analysis on startup.
GB_UI_AI_ANALYSIS_ENABLED=false

# Base URL of any OpenAI-compatible LLM endpoint. Leave empty to disable.
#
# Examples:
#   IBM RITS:  https://inference-3scale-apicast-production.apps.rits.fmaas.res.ibm.com
#   Ollama:    http://host.docker.internal:11434/v1
#   OpenAI:    https://api.openai.com/v1
GB_UI_LLM_BASE_URL=
GB_UI_LLM_API_KEY=
GB_UI_LLM_MODELS=granite-4.0-h-small,granite-3.3-8b-instruct

# ── Kubernetes sync (optional) ────────────────────────────────────────────────
# Path to YAML cluster config file (gb_dashboard-compatible format).
# When set, the K8s sync daemon starts on boot and populates workload stats.
# Leave empty to disable K8s sync locally.
GB_UI_CONFIG=

# Single kubeconfig fallback — only used when GB_UI_CONFIG is not set.
GB_UI_KUBECONFIG=
GB_UI_K8S_NAMESPACES=default
GB_UI_SYNC_INTERVAL=60

# ── Flight plans (GBMCP server) ──────────────────────────────────────────────
# Streamable-HTTP MCP endpoint for the flight plans feature.
# Leave empty to disable the /plans page (the backend returns 503 when unset).
GB_UI_GBMCP_URL=
