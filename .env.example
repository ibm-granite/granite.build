# ── granite.build environment configuration ───────────────────────────────────
# Copy this file to .env and fill in the values you need.
# The analytics service (gb_ui_backend) reads GB_UI_* vars from this file automatically.
#
# Minimum for standalone mode (dashboard only, no analytics):
#   GBSERVER_AUTH_MODE, GBSERVER_METADATA_STORAGE
#
# Add GB_UI_GBSERVER_DB_URL to enable the Build volume chart and Leaderboard.
# Add GB_UI_DATABASE_URL for full analytics and AI analysis (SQLite or PostgreSQL).

# ── gbserver ──────────────────────────────────────────────────────────────────

# Authentication mode: apikey (standalone/local), github, ibmid, or multi
GBSERVER_AUTH_MODE=apikey

# Storage backend: sqlite (local dev) or sql (PostgreSQL for production)
GBSERVER_METADATA_STORAGE=sqlite

# Optional: set a shared secret for API access. If unset, localhost is allowed
# without auth in apikey mode (convenient for local dev).
# GBSERVER_API_KEY=

# Optional: your display name in the dashboard greeting
# GBSERVER_API_USER=alice

# ── Analytics service (gb_ui_backend) ────────────────────────────────────────
# Set GB_UI_GBSERVER_DB_URL to enable the Build volume chart and Leaderboard
# without needing PostgreSQL. If gb_ui_backend is installed, gbserver includes
# its routers directly into its own process at startup when either DB
# variable below is set.

# Path to gbserver's own SQLite database (enables Build volume + Leaderboard).
# The default location after running `gbserver standalone` at least once:
# GB_UI_GBSERVER_DB_URL=sqlite+aiosqlite:////Users/you/.granite.build/llmb-server.db

# The analytics service's own database (enables full analytics, failure
# trends, AI). SQLite (local, no setup needed) or PostgreSQL (shared/production):
# GB_UI_DATABASE_URL=sqlite+aiosqlite:///${HOME}/.granite.build/dashboard-analytics.db
# GB_UI_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/gbui

# Used for the standalone dev-mode startup banner when running gb_ui_backend
# outside gbserver (python -m gb_ui_backend); not needed in the normal case.
GB_UI_GBSERVER_URL=http://localhost:8080

# ── AI analysis (optional) ────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. Requires GB_UI_DATABASE_URL (PostgreSQL) to
# store results. Without it analytics still work but AI analysis is disabled.
#
# Option A — Local Ollama (free, private, runs on your machine):
#   Install: https://ollama.com  then: ollama pull granite3.2
#   GB_UI_LLM_BASE_URL=http://localhost:11434/v1
#   GB_UI_LLM_API_KEY=ollama
#   GB_UI_LLM_MODELS=granite3.2
#
# Option B — IBM watsonx (cloud):
#   GB_UI_LLM_BASE_URL=https://us-south.ml.cloud.ibm.com/ml/v1/text/generation
#   GB_UI_LLM_API_KEY=<your-ibm-api-key>
#   GB_UI_LLM_MODELS=ibm/granite-3-3-8b-instruct
#
# Option C — Any OpenAI-compatible API:
#   GB_UI_LLM_BASE_URL=https://api.openai.com/v1
#   GB_UI_LLM_API_KEY=sk-...
#   GB_UI_LLM_MODELS=gpt-4o-mini
#
# GB_UI_LLM_BASE_URL=
# GB_UI_LLM_API_KEY=
# GB_UI_LLM_MODELS=granite-4.0-h-small,granite-3.3-8b-instruct

# ── Cloud logs (optional) ─────────────────────────────────────────────────────
# Enables the Logs tab on running builds. Requires a cloud logging service
# instance (e.g. IBM Cloud Logs).
# GB_UI_CLOUD_LOGS_URL=
# GB_UI_CLOUD_LOGS_API_KEY=
