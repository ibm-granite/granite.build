# Test image for TRL fine-tuning and unitxt evaluation (CPU-only, multi-arch).
# Built during test session; not published.
# ECR mirror of the Docker Hub image. Must match PYTHON_IMAGE in
# test-data/ci-docker-images.env.
FROM public.ecr.aws/docker/library/python:3.11-slim

RUN pip install --no-cache-dir \
    --extra-index-url https://download.pytorch.org/whl/cpu \
    torch \
    transformers \
    trl \
    peft \
    unitxt \
    datasets \
    accelerate
