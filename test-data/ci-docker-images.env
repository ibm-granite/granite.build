# Docker images the tests pull: NAME=image, one per line. This is the single
# source for the tests and for CI, which preloads these from the Actions cache
# (scripts/ci-docker-images.sh) and keys the cache on this file's hash.
#
# Files users run without the test harness keep their own literal copy, and
# test/unit/environment/test_ci_docker_images.py fails if they drift:
#   PYTHON_IMAGE: test-data/standalone-environments/docker/Dockerfile.cpu.test
#                 test-data/standalone-environments/steps/inference/step.yaml
ALPINE_IMAGE=public.ecr.aws/docker/library/alpine:3.22
PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.11-slim
