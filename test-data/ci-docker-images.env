# Docker images the tests use, as NAME=image. Single source for the tests and
# for CI's image cache (scripts/ci-docker-images.sh), keyed on this file's hash.
#
# Files users run without the test harness keep literal copies, checked by
# test/unit/environment/test_ci_docker_images.py:
#   PYTHON_IMAGE: standalone-environments/docker/Dockerfile.cpu.test
#                 standalone-environments/steps/inference/step.yaml
ALPINE_IMAGE=public.ecr.aws/docker/library/alpine:3.22
PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.11-slim
