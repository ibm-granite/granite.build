# Extra Docker images only the nightly extended tests use, as NAME=image (same
# format as ci-docker-images.env). Kept apart so adding one does not change the
# CI image cache key or make CI jobs pull an image they never run. The nightly
# caches these itself and loads them into kind (ci-docker-images.sh kind-load).
#
# Literal copies, checked by test/unit/environment/test_ci_docker_images.py:
#   UBUNTU_IMAGE: integration/standalone/buildrunner/skypilot_kube/1step-image/build.yaml
UBUNTU_IMAGE=public.ecr.aws/docker/library/ubuntu:24.04
