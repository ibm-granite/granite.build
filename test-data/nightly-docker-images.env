# Images only the nightly extended tests use, as NAME=image. Kept out of
# ci-docker-images.env so they don't change CI's cache key or CI's pulls.
#
# Literal copies, checked by test/unit/environment/test_ci_docker_images.py:
#   UBUNTU_IMAGE: integration/standalone/buildrunner/skypilot_kube/1step-image/build.yaml
UBUNTU_IMAGE=public.ecr.aws/docker/library/ubuntu:24.04
