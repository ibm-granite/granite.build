# api-bridge configuration — copy to .env and fill in real values.

# --- Database (required) ---
# Single SQLAlchemy connection string, shared with the main AutoTuneX service.
# SQLite, MySQL, and PostgreSQL are all supported; the driver is coerced to its
# synchronous equivalent automatically, so the SAME value the main service uses
# (e.g. mysql+asyncmy://... or postgresql+asyncpg://...) works here unchanged.
#   SQLite (dev):   sqlite:///./api_bridge.db
#   MySQL:          mysql+asyncmy://autotune:change-me@localhost:3306/autotune
#   PostgreSQL:     postgresql+asyncpg://autotune:change-me@localhost:5432/autotune
# PostgreSQL needs the optional driver:  pip install "autotunex-api-bridge[postgres]"
AUTOTUNEX_DATABASE_URL=sqlite:///./api_bridge.db
# TLS to the DB (MySQL only; the mode derives from the CA when unset):
# AUTOTUNEX_DATABASE_SSL_MODE=verify          # disable | require | verify
# AUTOTUNEX_DATABASE_SSL_CA=/path/to/db-ca.pem

# --- Server ---
API_BRIDGE_SERVER_PORT=8001
AUTOTUNE_SERVER_URL=http://localhost:8001
# Enable autoreload in development (1/true/yes):
# DEV_MODE=false

# --- Session signing (required) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me

# --- Authentication / OIDC (optional) ---
# Setting all three enables session-cookie (OIDC) authentication; if any is
# unset, the service trusts the caller's identity via the X-User-Email header
# (or the `email` cookie), falling back to DEV_USER_EMAIL/DEV_USER_ROLE below.
# OIDC_CLIENT_ID=your-oidc-client-id
# OIDC_CLIENT_SECRET=change-me
# OIDC_SECURITY_ENDPOINT=https://idp.example.com

# --- Logging ---
# LOG_LEVEL=INFO        # DEBUG|INFO|WARNING|ERROR
# LOG_FORMAT=text       # text|json

# --- GitHub / Granite Build integration (optional) ---
# GITHUB_HOST defaults to github.com; set to your GitHub Enterprise host if used.
# GITHUB_HOST=github.com
# GB_TOKEN=your-github-token
# DEV_USER_EMAIL=dev@example.com
# DEV_USER_ROLE=admin
