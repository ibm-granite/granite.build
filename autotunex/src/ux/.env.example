# AutoTuneX frontend environment variables.
#
# Copy this file to `.env` and fill in values for your environment:
#   cp .env.example .env
#
# All variables consumed by the browser bundle MUST be prefixed `PUBLIC_`
# (SvelteKit requirement). They are baked in at build time.

# --- API endpoint (required) ---------------------------------------------
# Host root the frontend calls for all backend requests. The client derives the
# backend's three roots from it: `/api/v1` (data), `/auth` (auth), `/health`.
# Set the HOST ROOT only — do NOT append `/api/v1` or `/fmtune/api` here.
# For local dev this points at the `/local` proxy defined in vite.config.ts
# (which forwards to PROXY_LOCAL_TARGET, default http://localhost:8000).
# For a deployed environment, set the host root, e.g.
#   PUBLIC_AUTOTUNEX_API_URL=https://your-host.example.com
PUBLIC_AUTOTUNEX_API_URL=/local

# --- Local auth bypass (dev only) ----------------------------------------
# Skip the OIDC login flow during local development and inject a fake user.
# Never enable these in a deployed environment.
# PUBLIC_BYPASS_AUTH=true
# PUBLIC_USER_EMAIL=dev@example.com
# PUBLIC_USER_ROLE=admin
# PUBLIC_USER_TOKEN=local-dev-token

# --- Dev-only proxy targets (optional) -----------------------------------
# Used by `npm run dev` (vite.config.ts). Each maps a path prefix to a
# backend. `/local` defaults to http://localhost:8000; the others are
# disabled unless a target is set.
# PROXY_LOCAL_TARGET=http://localhost:8000
# PROXY_STAGE_TARGET=
# PROXY_PROD_TARGET=
