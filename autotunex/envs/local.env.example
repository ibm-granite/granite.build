# AutoTuneX — LOCAL runner example configuration
#
# Runner: the in-process HPO runner (AUTOTUNEX_JOB_BACKEND=local). Runs the
# `autotune` hyperparameter search directly in this process via Ray — no
# granite.build, no cluster, no external tokens. Best for a laptop or dev box.
#
# Use it:
#   cp envs/local.env.example .env
#   make dev
#
# Runtime prerequisites (not env vars):
#   • the `autotune` package must be importable in this environment
#   • the dataset's files must exist on disk under AUTOTUNEX_DATASET_STORAGE_DIR
#     (this runner reads training data locally; it never pulls from HuggingFace)
#
# This file covers what the local runner needs for development. For everything
# else — the optional auth providers (OIDC / BFF / API keys), serving the built
# UI, dataset-preview tuning, and the LLM-intelligence feature — see the full
# menu in the root .env.example. Every AUTOTUNEX_ variable is documented in
# src/autotunex/core/config.py.
# Runner design: docs/superpowers/specs/2026-08-11-local-and-bash-runners-design.md

# --- Application -----------------------------------------------------------
AUTOTUNEX_APP_NAME="AutoTuneX API"
# dev | test | prod
AUTOTUNEX_ENVIRONMENT=dev
AUTOTUNEX_DEBUG=false
AUTOTUNEX_LOG_LEVEL=INFO
AUTOTUNEX_API_PREFIX=/api/v1

# --- Database --------------------------------------------------------------
# SQLite for local development; no server needed.
AUTOTUNEX_DATABASE_URL=sqlite+aiosqlite:///./autotunex.db
AUTOTUNEX_DATABASE_ECHO=false
# Create missing tables on startup (dev convenience; use `make migrate` in prod).
AUTOTUNEX_AUTO_CREATE_SCHEMA=true

# --- Artifact storage ------------------------------------------------------
AUTOTUNEX_ARTIFACT_DIR=./artifacts

# --- Auth (standalone / dev) -----------------------------------------------
# A JSON array, NOT a comma-separated list. "disabled" is standalone mode: every
# caller is the same principal. Leaving STANDALONE_EMAIL unset attributes writes
# to a default system owner (standalone@autotunex.local).
AUTOTUNEX_AUTH_PROVIDERS=["disabled"]
# AUTOTUNEX_STANDALONE_EMAIL=you@example.com
AUTOTUNEX_STANDALONE_ROLE=admin
# AUTOTUNEX_AUTO_PROVISION_USERS=true

# --- Execution: the local runner -------------------------------------------
# Selects LocalJobRunner: runs the autotune HPO in-process (Ray Tune), persists
# trials/results/logs, and drives the job to a terminal state itself.
AUTOTUNEX_JOB_BACKEND=local

# Ray cluster address. Unset → a local Ray (`ray.init()`), the usual dev choice.
# AUTOTUNEX_LOCAL_RAY_ADDRESS=ray://localhost:10001

# Root for a local run's output; the per-job subdir is <dir>/<job_id>/.
# Defaults to a sibling of the artifact dir (artifacts/local).
AUTOTUNEX_LOCAL_OUTPUT_DIR=artifacts/local

# --- Dataset storage (local backend) ---------------------------------------
# The local runner reads training data from disk, so force local storage. Files
# are read from <dir>/<dataset_id>/<name>_<split>.<ext>. No HF/GB tokens needed.
AUTOTUNEX_DATASET_STORAGE_BACKEND=local
AUTOTUNEX_DATASET_STORAGE_DIR=artifacts/datasets

# --- Limits ----------------------------------------------------------------
# Server-side ceiling on max_trials (reserved; not yet enforced).
AUTOTUNEX_MAX_TRIALS_LIMIT=100
