# AutoTuneX — REMOTE runner example configuration (granite.build custom_code)
#
# Runner: the remote granite.build cluster launcher (AUTOTUNEX_JOB_BACKEND=llmb,
# with GB_ENVIRONMENT left UNSET). Emits the space://steps/custom_code
# build.yaml and submits it through the llmb CLI to run the tuning build on a
# cluster.
#
# Use it:
#   export GB_TOKEN=<your gb token>     # REQUIRED — see the note below
#   export HF_TOKEN=<your hf token>     # REQUIRED — datasets are HF-hosted
#   cp envs/remote.env.example .env
#   # fill in the required cluster inputs below, then:
#   make dev
#
# GB_TOKEN must be EXPORTED into the shell, not merely written here: the
# reconcile loop authenticates to gbserver with it over HTTP, and startup
# refuses to run if the variable is absent (its value is never read into
# Settings). HF_TOKEN is required the same way once dataset storage is
# huggingface (below).
#
# Runtime prerequisite: datasets must be HuggingFace-hosted (the remote build
# pulls them by hf:// URI).
#
# This file covers what the remote runner needs. For everything else — the
# optional auth providers (OIDC / BFF / API keys), serving the built UI,
# dataset-preview tuning, and the LLM-intelligence feature — see the full menu
# in the root .env.example. Every AUTOTUNEX_ variable is documented in
# src/autotunex/core/config.py.
# Runner design: docs/superpowers/specs/2026-08-11-local-and-bash-runners-design.md

# --- Application -----------------------------------------------------------
AUTOTUNEX_APP_NAME="AutoTuneX API"
# dev | test | prod
AUTOTUNEX_ENVIRONMENT=dev
AUTOTUNEX_DEBUG=false
AUTOTUNEX_LOG_LEVEL=INFO
AUTOTUNEX_API_PREFIX=/api/v1

# --- Database --------------------------------------------------------------
# SQLite for local development; no server needed.
AUTOTUNEX_DATABASE_URL=sqlite+aiosqlite:///./autotunex.db
AUTOTUNEX_DATABASE_ECHO=false
# Create missing tables on startup (dev convenience; use `make migrate` in prod).
AUTOTUNEX_AUTO_CREATE_SCHEMA=true

# --- Artifact storage ------------------------------------------------------
AUTOTUNEX_ARTIFACT_DIR=./artifacts

# --- Auth (standalone / dev) -----------------------------------------------
# A JSON array, NOT a comma-separated list. "disabled" is standalone mode: every
# caller is the same principal. Leaving STANDALONE_EMAIL unset attributes writes
# to a default system owner (standalone@autotunex.local).
AUTOTUNEX_AUTH_PROVIDERS=["disabled"]
# AUTOTUNEX_STANDALONE_EMAIL=you@example.com
AUTOTUNEX_STANDALONE_ROLE=admin
# AUTOTUNEX_AUTO_PROVISION_USERS=true

# --- Execution: the remote custom_code launcher ----------------------------
# JOB_BACKEND=llmb selects the llmb launcher. Leave GB_ENVIRONMENT UNSET so it
# emits the remote custom_code spec (setting it to "standalone" would switch to
# the local-bash spec — see envs/bash.env.example).
AUTOTUNEX_JOB_BACKEND=llmb

# Container image the cluster runs the tuning build in. REQUIRED.
AUTOTUNEX_JOB_RUNTIME_IMAGE=registry.example.com/tuner:1
# Trainer source repository the build checks out. REQUIRED.
AUTOTUNEX_JOB_TRAINER_REPO=https://github.example.com/org/trainer.git
# Branch/tag/commit of the trainer repo to check out.
AUTOTUNEX_JOB_TRAINER_REF=main
# Root URI for run artifacts; each run writes under a subpath of this. REQUIRED.
AUTOTUNEX_JOB_OUTPUT_URI_ROOT=s3://your-bucket/runs

# Base URL of the gbserver the reconcile loop polls for job status. REQUIRED —
# without it an accepted job sits "pending" forever.
AUTOTUNEX_GB_SERVER_URL=https://gbserver.example.com

# Name of the env var holding the gb auth token (see the export note above).
AUTOTUNEX_GB_TOKEN_ENV=GB_TOKEN

# The llmb CLI binary name or path used to submit builds.
AUTOTUNEX_LLMB_COMMAND=llmb

# Where the generated build.yaml is written (<dir>/<job_id>/build.yaml).
AUTOTUNEX_JOB_SPEC_DIR=tmp

# Base URL a cluster worker reports back to (optional; inert until ingest ships).
# AUTOTUNEX_JOB_CALLBACK_URL=https://api.example.com

# How often the reconcile loop sweeps non-terminal jobs, and the per-sweep read cap.
AUTOTUNEX_JOB_RECONCILE_INTERVAL_SECONDS=30
AUTOTUNEX_JOB_RECONCILE_CONCURRENCY=5

# --- Dataset storage (HuggingFace backend) ---------------------------------
# The remote build pulls datasets by hf:// URI, so datasets must be pushed to
# HuggingFace. Forcing "huggingface" fails startup unless BOTH GB_TOKEN and
# HF_TOKEN are exported (checked at startup; the values never enter Settings).
AUTOTUNEX_DATASET_STORAGE_BACKEND=huggingface
# Optional HF org/namespace prefix for the pushed dataset repo.
# AUTOTUNEX_HF_NAMESPACE=your-org

# --- Limits ----------------------------------------------------------------
# Server-side ceiling on max_trials (reserved; not yet enforced).
AUTOTUNEX_MAX_TRIALS_LIMIT=100
