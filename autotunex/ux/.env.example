# AutoTuneX frontend environment variables.
#
# Copy this file to `.env` and fill in values for your environment:
#   cp .env.example .env
#
# All variables consumed by the browser bundle MUST be prefixed `PUBLIC_`
# (SvelteKit requirement). They are baked in at build time.

# --- API endpoint (required) ---------------------------------------------
# Base URL the frontend calls for all backend requests.
# For local dev this points at the `/local` proxy defined in vite.config.ts
# (which forwards to PROXY_LOCAL_TARGET, default http://localhost:8000).
# For a deployed environment, set the full API base, e.g.
#   PUBLIC_AUTOTUNEX_API_URL=https://your-host.example.com/fmtune/api
PUBLIC_AUTOTUNEX_API_URL=/local/fmtune/api

# --- Authentication (server-side) ----------------------------------------
# The frontend does not control authentication — it trusts the API's
# `/auth/validate` response. There is no frontend bypass variable.
# To run without OIDC during local development, leave the API server's
# OIDC_CLIENT_ID / OIDC_CLIENT_SECRET / OIDC_SECURITY_ENDPOINT unset (or set
# AUTOTUNEX_AUTH=dev); the API then resolves to a dev provider that treats
# every request as an admin user. Never do this in a deployed environment.

# --- External UI links (optional) ----------------------------------------
# Base URLs for "Open in DMF" / "Open RITS" buttons. Leave unset to hide the
# corresponding buttons (no default host is assumed).
#   PUBLIC_DMF_UI_URL=https://your-dmf-ui.example.com
#   PUBLIC_RITS_UI_URL=https://your-rits-ui.example.com
# PUBLIC_DMF_UI_URL=
# PUBLIC_RITS_UI_URL=

# --- Dev-only proxy targets (optional) -----------------------------------
# Used by `npm run dev` (vite.config.ts). Each maps a path prefix to a
# backend. `/local` defaults to http://localhost:8000; the others are
# disabled unless a target is set.
# PROXY_LOCAL_TARGET=http://localhost:8000
# PROXY_STAGE_TARGET=
# PROXY_PROD_TARGET=
# PROXY_DMF_TARGET=
