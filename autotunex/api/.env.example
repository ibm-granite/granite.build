# AutoTuneX API server — environment template.
#
# Copy to `.env` and fill in values (`.env` is git-ignored). Every variable the
# API server reads is listed here; those with a built-in default are marked
# "(default: ...)" and can be omitted. Frontend `PUBLIC_*` vars belong in
# `ux/.env`, NOT here — the API server never reads them.

# ── Database (MySQL) ──────────────────────────────────────────────
# The API server and API bridge share one database. The db name can be given as
# DB_NAME or DB_SCHEMA — DB_SCHEMA wins if both are set. Prefer DB_NAME so the
# same secret works for both services (the bridge reads DB_NAME/DB_SCHEMA too).
DB_HOST=localhost
DB_PORT=3306
DB_USER=autotune
DB_PASSWORD=change-me
DB_NAME=autotunex
# DB_KEY=/path/to/db-client-key.pem   # optional: TLS client key path
# Connection-pool tuning (defaults shown):
# DB_POOL_MIN_SIZE=5
# DB_POOL_MAX_SIZE=30
# DB_POOL_RECYCLE=60

# ── Authentication (IBM w3id OIDC) ────────────────────────────────
# Leave the OIDC_* trio empty to run without OIDC (dev auth provider is used).
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SECURITY_ENDPOINT=
SESSION_SECRET=change-me-to-a-long-random-string
# Dev auth identity, used only when OIDC is not configured:
# DEV_USER_EMAIL=dev@example.com   # (default: dev@example.com)
# DEV_USER_ROLE=admin            # (default: admin)

# ── Granite Build (optional; enables the GB runner/backends) ──────
# Set GB_TOKEN to enable Granite Build. When unset, GB features are disabled.
# GB_TOKEN=
# AUTOTUNE_SERVER_BRIDGE_URL=http://localhost:8001   # injected into remote GB builds
# GB status cache (defaults shown):
# GB_STATUS_CACHE_TTL=45
# GB_STATUS_CACHE_MAX_SIZE=50
# Repo (cloned by the GB runtime) holding the autotune training library.
# GB_TUNE_REPO=github.com/ibm-research/fm-tune.git   # (default shown)

# ── GitHub host (GB PR lookup + PR-URL parsing) ───────────────────
# Host for the GitHub REST API and Granite Build PR URLs. Public GitHub uses
# api.github.com; a GitHub Enterprise host uses <host>/api/v3 (derived).
# GITHUB_HOST=github.com                 # (default shown) e.g. github.ibm.com for IBM

# ── DMF / Lakehouse model registry (optional, IBM-only) ───────────
# DMF_API_URL=https://api.dmf.vpc-int.res.ibm.com
# LAKEHOUSE_TOKEN=            # DMF/lakehouse auth token
# LAKEHOUSE_ENVIRONMENT=      # read by the lakehouse SDK (LakehouseIceberg config="env")
# DMF_CACHE=                  # (default: <AUTOTUNEX_DATA_DIR>/cache)
# Base URL of the DMF model-detail UI. No default — when unset, published-model
# responses omit the dmf_url link. IBM example:
# DMF_UI_URL=https://ui.dmf.vpc-int.res.ibm.com

# ── LLM proxy (chat, reward validation, dataset intelligence) ─────
# Dataset intelligence and reward validation prefer LiteLLM and fall back to the
# OpenAI-compatible endpoint below. Chat backend selection uses AUTOTUNEX_CHAT.
LITELLM_URL=
LITELLM_API_KEY=
# LITELLM_MODEL=aws/claude-sonnet-4-6   # (default: aws/claude-sonnet-4-6; dataset intelligence defaults to claude-sonnet-4-6)
# OpenAI-compatible endpoint (chat when AUTOTUNEX_CHAT=openai_compatible; also the
# fallback backend for dataset intelligence when LITELLM_* is unset):
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini              # (default: gpt-4o-mini)
# RITS_TTL=1440m                        # (default: 1440m) model push TTL

# ── MCP server / chat agent ───────────────────────────────────────
# ENABLE_MCP=true                       # (default: false) mount MCP at /mcp
# MCP_SERVER_URL=http://localhost:8000/mcp   # (default shown) chat agent tool discovery

# ── Storage / paths ───────────────────────────────────────────────
# All data dirs default to a subfolder under AUTOTUNEX_DATA_DIR. Set that one
# var to relocate everything; override an individual var to move just that dir.
# AUTOTUNEX_DATA_DIR=./AUTOTUNEX_DATA   # (default: <cwd>/AUTOTUNEX_DATA) data root
# AUTOTUNE_DATASETS_PATH=               # (default: <AUTOTUNEX_DATA_DIR>/datasets) dataset uploads
# AUTOTUNE_RESULTS_PATH=                # (default: <AUTOTUNEX_DATA_DIR>/results) job output root
# AUTOTUNEX_MODELS_DIR=                 # (default: <AUTOTUNE_RESULTS_PATH>/registry)
# UPLOAD_STAGING_TTL_MINUTES=360        # (default: 360) tus upload staging retention

# ── Provider-seam selection (OSS pluggability; all optional) ──────
# Override the auto-detected provider for each seam. Leave unset for defaults.
# AUTOTUNEX_RUNNER=local        # local | gb
# AUTOTUNEX_REGISTRY=local      # local | dmf | hf
# AUTOTUNEX_AUTH=dev            # dev | w3id
# AUTOTUNEX_CHAT=litellm        # litellm | openai_compatible
# AUTOTUNEX_STORAGE=local       # local | gb

# ── Runtime / server ──────────────────────────────────────────────
# DEV_MODE=false                # (default: false) uvicorn auto-reload
# LOG_LEVEL=INFO                # (default: INFO)
# LOG_PATH=                     # (default: <AUTOTUNEX_DATA_DIR>/logs) log file directory
# AUTOTUNE_SERVER_URL=http://localhost:8000   # (default shown) OpenAPI server URL
# UX_BUILD_DIR=/app/api/ux_build              # (default shown) SPA mount for single-container mode
