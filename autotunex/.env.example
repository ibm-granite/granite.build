# AutoTuneX docker-compose — root environment template.
#
#   cp .env.example .env      # then edit the secrets below
#   docker compose up -d
#
# docker compose auto-reads this file (as .env) and interpolates the values into
# docker-compose.yml. Every service gets only the subset it needs. All values
# have working defaults baked into the compose file, so the stack runs even with
# an empty .env — but you SHOULD change the passwords and SESSION_SECRET.

# ── Image / build ─────────────────────────────────────────────────
# App base image. Default is a small CPU image (explore the platform, no GPU).
# For local GPU training you also need the IBM training core (an opt-in extra —
# see the Docker Compose section in README.md); switch to the CUDA base with:
#   BASE_IMAGE=nvidia/cuda:12.6.3-devel-ubuntu22.04
BASE_IMAGE=python:3.11-slim
# Optional pip extras for the API install. Empty (default) = credential-free,
# public-PyPI-only base. Set to a bracketed extra to opt in:
#   APP_EXTRAS=[granite-build]   Granite Build runner (needs GH_USER/GH_TOKEN + GB_TOKEN below)
#   APP_EXTRAS=[ibm]             full IBM profile (GB + DMF + training core)
# APP_EXTRAS=
# GitHub creds for the github.ibm.com dependency pulled in by APP_EXTRAS above.
# Only needed when APP_EXTRAS is set to an extra that includes an IBM git package.
# GH_USER=
# GH_TOKEN=

# ── Database (shared by app + bridge + mysql) ─────────────────────
# Keep DB_NAME=autotune: the schema file (auto-loaded on first boot) hardcodes
# `CREATE DATABASE IF NOT EXISTS autotune; USE autotune;`.
DB_ROOT_PASSWORD=change-me-root
DB_NAME=autotune
DB_USER=autotune
DB_PASSWORD=change-me
# Local MySQL presents a self-signed cert, so identity verification is off (TLS
# is still negotiated). Set to true for a MySQL with a verifiable certificate.
DB_SSL_VERIFY_IDENTITY=false

# ── Auth (local dev provider; no OIDC out of the box) ─────────────
AUTOTUNEX_AUTH=dev
DEV_USER_EMAIL=dev@example.com
DEV_USER_ROLE=admin
# Used to sign sessions — change this to a long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# ── Provider seams (local-only default) ──────────────────────────
AUTOTUNEX_RUNNER=local
AUTOTUNEX_STORAGE=local
AUTOTUNEX_REGISTRY=local

# ── Granite Build (optional) ──────────────────────────────────────
# GB turns on only when BOTH are true:
#   1. the image was built with APP_EXTRAS=[granite-build] (installs the gb CLI), and
#   2. GB_TOKEN is set here.
# With APP_EXTRAS empty, setting GB_TOKEN alone has no effect (the gb CLI is absent
# and is_gb_enabled() stays false), so the stack safely runs local-only.
# GB_TOKEN=
# AUTOTUNEX_RUNNER=gb   # route jobs to the Granite Build runner instead of local

# ── Optional LLM proxy (chat + dataset intelligence) ──────────────
# Leave unset to disable the AI assistant / intelligent dataset features.
# LITELLM_URL=
# LITELLM_API_KEY=

# ── Host ports ────────────────────────────────────────────────────
APP_PORT=8000
BRIDGE_PORT=8001

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=text
