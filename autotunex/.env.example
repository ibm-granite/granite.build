# AutoTuneX configuration
#
# Copy to .env and edit. Every value here is a default from
# src/autotunex/core/config.py — the defaults work as-is for local development,
# so you can start by copying this file unchanged.
#
#   cp .env.example .env
#
# All variables are prefixed AUTOTUNEX_. Never commit .env.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
AUTOTUNEX_APP_NAME="AutoTuneX API"

# dev | test | prod
AUTOTUNEX_ENVIRONMENT=dev

# Verbose error output. Keep false in production.
AUTOTUNEX_DEBUG=false

# DEBUG | INFO | WARNING | ERROR
AUTOTUNEX_LOG_LEVEL=INFO

# Path prefix the versioned API is mounted under. /health sits outside it.
AUTOTUNEX_API_PREFIX=/api/v1

# Optionally serve the built SvelteKit SPA from this service. Point FRONTEND_DIR
# at the build output (a local checkout builds it to src/ux/build); leave unset
# to run API-only with the UI hosted separately. FRONTEND_BASE_PATH must match
# the UI's kit.paths.base (baked into asset URLs at build time), default /autotune.
# AUTOTUNEX_FRONTEND_DIR=src/ux/build
# AUTOTUNEX_FRONTEND_BASE_PATH=/autotune

# ---------------------------------------------------------------------------
# Database — job and trial state
# ---------------------------------------------------------------------------
# SQLite for local development; no server needed.
AUTOTUNEX_DATABASE_URL=sqlite+aiosqlite:///./autotunex.db

# For production, use PostgreSQL and install the extra: pip install -e ".[postgres]"
# AUTOTUNEX_DATABASE_URL=postgresql+asyncpg://autotunex:CHANGEME@localhost:5432/autotunex

# MySQL (production). Requires the mysql extra: pip install -e ".[mysql]"
# AUTOTUNEX_DATABASE_URL=mysql+asyncmy://user:password@localhost:3306/autotune

# Managed MySQL (e.g. IBM Cloud Databases for MySQL) accepts only TLS connections
# and signs its certificate with a private CA. Point this at the CA PEM downloaded
# from the deployment (`ibmcloud cdb deployment-cacertificate <deployment>` or the
# console) to verify the server. Leave unset for local SQLite/Postgres/MySQL.
# AUTOTUNEX_DATABASE_SSL_CA=/path/to/ibm-cloud-mysql-ca.pem

# How to negotiate TLS to the database (MySQL only):
#   disable  no TLS (local dev)
#   require  encrypt but DO NOT verify the server cert — no CA file needed. Use
#            this to connect to managed MySQL without a certificate (dev only:
#            it stops eavesdropping but not an active man-in-the-middle).
#   verify   encrypt AND verify against AUTOTUNEX_DATABASE_SSL_CA (needs the CA).
# Unset (default) derives it: `verify` if a CA is set above, else `disable`.
# AUTOTUNEX_DATABASE_SSL_MODE=require

# Log every SQL statement. Noisy; useful when debugging queries.
AUTOTUNEX_DATABASE_ECHO=false

# Create missing tables on startup. Convenient in dev; set false in production
# and run migrations instead (`make migrate`).
AUTOTUNEX_AUTO_CREATE_SCHEMA=true

# Connection pool. These matter against managed MySQL (IBM Cloud Databases),
# where a new connection pays a full TLS + caching_sha2_password handshake.
# Defaults shown.
#
# Warm connections kept open per worker and reused; size to cover request
# handlers plus the reconcile loop. Ignored for SQLite.
# AUTOTUNEX_DATABASE_POOL_SIZE=10
# Extra connections opened on demand beyond pool size; hard ceiling is
# size + overflow. Ignored for SQLite.
# AUTOTUNEX_DATABASE_MAX_OVERFLOW=5
# Seconds a request waits for a free connection before failing. Ignored for SQLite.
# AUTOTUNEX_DATABASE_POOL_TIMEOUT_SECONDS=30.0
# Recycle a connection older than this many seconds (-1 disables); keep it under
# the database's wait_timeout (IBM Cloud MySQL defaults to 3600s). Server databases only.
# AUTOTUNEX_DATABASE_POOL_RECYCLE_SECONDS=1800
# Liveness-check a pooled connection on checkout, reconnecting if it is dead.
# Applies to every pool, SQLite included.
# AUTOTUNEX_DATABASE_POOL_PRE_PING=true
# Hand out the most-recently-used connection first, keeping a hot subset under
# bursty traffic. Ignored for SQLite.
# AUTOTUNEX_DATABASE_POOL_USE_LIFO=true

# ---------------------------------------------------------------------------
# Artifact storage — trained adapters and checkpoints
# ---------------------------------------------------------------------------
# Local directory today. Object storage (S3 / IBM COS) is not implemented yet.
AUTOTUNEX_ARTIFACT_DIR=./artifacts

# ---------------------------------------------------------------------------
# Task queue — NOT IMPLEMENTED
# ---------------------------------------------------------------------------
# Reserved for the future JobRunner implementation. Setting it has no effect
# today: no worker exists, so submitted jobs stay in status "pending".
# See "Open decisions" in CLAUDE.md.
# AUTOTUNEX_QUEUE_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Execution / job launch — submitting an accepted job to a cluster
# ---------------------------------------------------------------------------
# Which JobRunner to build. "none" (default) selects NoOpJobRunner: accepted
# jobs stay "pending" and nothing is submitted anywhere. "llmb" selects
# InProcessJobRunner, which submits builds via the llmb CLI — the four settings
# below (JOB_RUNTIME_IMAGE, JOB_TRAINER_REPO, JOB_OUTPUT_URI_ROOT and
# GB_SERVER_URL), plus the env var named by AUTOTUNEX_GB_TOKEN_ENV, are then
# required (but see GB_ENVIRONMENT: the standalone local-bash variant drops the
# first three and needs only GB_SERVER_URL plus that env var). "local" selects
# LocalJobRunner, which runs the autotune HPO in-process (no granite.build;
# requires the `autotune` package installed and the dataset's files present on
# disk). See
# docs/superpowers/specs/2026-08-06-job-launch-runner-design.md and
# docs/superpowers/specs/2026-08-11-local-and-bash-runners-design.md.
AUTOTUNEX_JOB_BACKEND=none

# Container image the cluster runs the tuning build in. Required when
# AUTOTUNEX_JOB_BACKEND=llmb.
# AUTOTUNEX_JOB_RUNTIME_IMAGE=registry/tuner:1

# Trainer source repository the build checks out. Required when
# AUTOTUNEX_JOB_BACKEND=llmb.
# AUTOTUNEX_JOB_TRAINER_REPO=https://example.com/trainer.git

# Branch/tag/commit of AUTOTUNEX_JOB_TRAINER_REPO to check out.
AUTOTUNEX_JOB_TRAINER_REF=main

# Root URI for run artifacts; each run's output is written under a subpath of
# this. Required when AUTOTUNEX_JOB_BACKEND=llmb.
# AUTOTUNEX_JOB_OUTPUT_URI_ROOT=s3://bucket/runs

# The api-bridge / callback base URL the build reports to. The custom_code and
# LSF start commands emit it as --autotunex_server_url only when it is set; the
# standalone local-bash variant ALWAYS emits it as AUTOTUNEX_SERVER_URL,
# defaulting to http://localhost:8001 (the api-bridge) when this is unset.
# AUTOTUNEX_JOB_CALLBACK_URL=https://api.example.com

# Where the generated build.yaml is written, one per job at
# <dir>/<job_id>/build.yaml. Relative paths resolve against the working
# directory (the repo root under uvicorn). The spec is kept after submission —
# including on failure — so you can inspect or replay it; the default tmp/ is
# git-ignored.
AUTOTUNEX_JOB_SPEC_DIR=tmp

# Name of the env var holding the llmb/gb auth token. Before `build start` the
# launcher runs `llmb auth login --token <value>`, reading the token from this
# variable (mirrors HF_TOKEN handling — the value never enters Settings). When
# AUTOTUNEX_JOB_BACKEND=llmb — for BOTH the remote custom_code and the standalone
# local-bash variants — the env var named here MUST be present at startup, e.g.
# GB_TOKEN=...; there is no ambient-credential fallback, so startup fails if it
# is unset.
AUTOTUNEX_GB_TOKEN_ENV=GB_TOKEN

# Base URL of the gbserver the reconcile loop polls for job status. REQUIRED
# when AUTOTUNEX_JOB_BACKEND=llmb — for ALL THREE variants (the remote
# custom_code, the standalone local-bash, and the standalone LSF/SkyPilot spec
# selected by AUTOTUNEX_LSF_CLUSTER) — since without it an accepted job would sit
# "pending" forever (the reconcile loop is the only thing that advances it). For
# a local granite.build standalone this points at your local gbserver.
# AUTOTUNEX_GB_SERVER_URL=http://localhost:9000

# The llmb/gb CLI binary name or path used to submit builds (and to push
# datasets when the HuggingFace storage backend is active).
AUTOTUNEX_LLMB_COMMAND=llmb

# Tag(s) applied via `--tag` to BOTH `llmb build start` (job launch) and
# `llmb artifact push` (HuggingFace dataset push). A single tag or a
# comma-separated list (e.g. "autotunex,team-hpo") — forwarded verbatim; llmb
# splits the list itself. Defaults to "autotunex". Set it empty to disable
# tagging entirely (the `--tag` flag is then omitted from both commands).
AUTOTUNEX_GB_TAGS=autotunex

# How often the reconcile loop sweeps non-terminal llmb jobs for status changes,
# and the cap on simultaneous gbserver reads per sweep. llmb backend only.
AUTOTUNEX_JOB_RECONCILE_INTERVAL_SECONDS=30
AUTOTUNEX_JOB_RECONCILE_CONCURRENCY=5

# granite.build's own (UNPREFIXED) environment name. When set to "standalone"
# AND AUTOTUNEX_JOB_BACKEND=llmb, the launcher emits the local-bash build spec
# (space://environments/bash + space://steps/autotune) instead of the remote
# custom_code spec — an example of granite.build + AutoTuneX integration on a
# laptop/Mac. In that mode JOB_RUNTIME_IMAGE/JOB_TRAINER_REPO/JOB_OUTPUT_URI_ROOT
# are not required (only AUTOTUNEX_GB_SERVER_URL is). Note: no AUTOTUNEX_ prefix.
# GB_ENVIRONMENT=standalone

# Env values embedded in the local-bash build's bash.env (only used by the bash
# variant above). BACKEND is "mlx" (Apple Silicon) or "torch".
# AUTOTUNEX_BASH_FM_TUNE_ROOT=https://github.example.com/org/fm-tune
# Optional fm-tune branch/tag/commit; unset uses the repo's default branch.
# AUTOTUNEX_BASH_FM_TUNE_REF=main
AUTOTUNEX_BASH_FM_TUNE_EXTRA=full,mlx
AUTOTUNEX_BASH_BACKEND=mlx

# --- Execution: LSF / SkyPilot standalone runner ---------------------------
# When AUTOTUNEX_JOB_BACKEND=llmb and GB_ENVIRONMENT=standalone, setting
# AUTOTUNEX_LSF_CLUSTER switches the emitted build.yaml from the local-bash spec
# to the LSF/SkyPilot spec (space://steps/autotunex-tune). See envs/lsf.env.example
# for a complete, copy-and-run LSF configuration.
# Required at startup in this variant: AUTOTUNEX_LSF_ENVIRONMENT_URI,
# AUTOTUNEX_LSF_IMAGE, AUTOTUNEX_GB_SERVER_URL and — the surprise, since the
# standalone local-bash block above drops it — AUTOTUNEX_JOB_TRAINER_REPO again.
# AUTOTUNEX_LSF_CLUSTER is only the discriminator, not part of that fail-fast
# set; every other LSF_* setting below is optional.
# AUTOTUNEX_LSF_CLUSTER=example-cluster
# AUTOTUNEX_LSF_ENVIRONMENT_URI=space://environments/skypilot/lsf/example-cluster
# AUTOTUNEX_LSF_IMAGE=registry.example.com/tuner:1
# AUTOTUNEX_LSF_ACCELERATORS=H100:2
# AUTOTUNEX_LSF_QUEUE=normal
# AUTOTUNEX_LSF_MEMORY=256+
AUTOTUNEX_LSF_VENV_PATH=/step_venv
AUTOTUNEX_LSF_CUDA_HOME=/opt/share/cuda-12.9
AUTOTUNEX_LSF_NUM_CPUS_PER_NODE=32
AUTOTUNEX_LSF_TOTAL_MEMORY_PER_NODE=256Gi
AUTOTUNEX_LSF_POLL_INTERVAL_SECONDS=30

# ---------------------------------------------------------------------------
# Execution / local runner — running the autotune HPO in this process
# ---------------------------------------------------------------------------
# Only used when AUTOTUNEX_JOB_BACKEND=local. Ray cluster address; unset means
# a local Ray (`ray.init()`).
# AUTOTUNEX_LOCAL_RAY_ADDRESS=ray://localhost:10001

# Root for a local run's output; the per-job subdir is <dir>/<job_id>/.
# Defaults to a subdirectory of the artifact dir (artifacts/local).
AUTOTUNEX_LOCAL_OUTPUT_DIR=artifacts/local

# Seconds to wait for a local in-process run to stop on cancel/delete before
# returning "still stopping; retry shortly" (the cancel is latched regardless).
AUTOTUNEX_LOCAL_CANCEL_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
# Reserved for a future server-side ceiling on max_trials for any submitted
# job. Retained but not yet enforced by anything — setting it today has no
# effect. See "Open decisions" in CLAUDE.md.
AUTOTUNEX_MAX_TRIALS_LIMIT=100

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# A JSON array — NOT a comma-separated list. pydantic-settings parses list
# fields as JSON, so writing AUTOTUNEX_AUTH_PROVIDERS=disabled crashes at startup
# with `SettingsError: error parsing value for field "auth_providers"`. Keep the
# brackets and the quotes.
#
# "disabled" (the default) is standalone mode: every caller is treated as the
# same principal, narrowed by the two settings below. AUTOTUNEX_ENVIRONMENT=prod
# refuses to start while auth is disabled — "disabled" can never combine with
# another provider, so a legal production configuration means switching this to
# a real provider instead, e.g. ["api_key"] (see the AUTOTUNEX_API_KEYS block
# below). See the Authentication section of README.md.
AUTOTUNEX_AUTH_PROVIDERS=["disabled"]

# Narrows the standalone principal to one email. On its own this does NOT make
# you a non-admin: AUTOTUNEX_STANDALONE_ROLE below defaults to "admin", so you
# need BOTH lines to develop as an ordinary user. Leave the email unset to run as
# an unrestricted admin — but note that the per-caller scoping path is then never
# exercised outside the test suite.
# AUTOTUNEX_STANDALONE_EMAIL=you@example.com

# The role the standalone principal carries — always, whether or not
# AUTOTUNEX_STANDALONE_EMAIL is set. "admin" (default) or "user". This setting
# wins over the users.role column, so you can run as a non-admin even if your
# real row says admin.
AUTOTUNEX_STANDALONE_ROLE=admin

# With AUTOTUNEX_AUTH_PROVIDERS=["disabled"] and AUTOTUNEX_STANDALONE_EMAIL unset,
# writes (configurations, datasets) are attributed to a default system owner
# (standalone@autotunex.local), provisioned on first request. Set
# AUTOTUNEX_STANDALONE_EMAIL to attribute them to a named owner instead.
#
# No-auth is refused at startup when AUTOTUNEX_ENVIRONMENT=prod unless you opt in
# deliberately (a single-tenant deployment that genuinely wants no auth):
# AUTOTUNEX_ALLOW_INSECURE_NO_AUTH=true

# Just-in-time user provisioning. Off by default (an authorization policy). When
# true, a caller with a resolvable, verified email but no users row gets one
# created on their first request (always role="user", never admin), so they own
# what they create instead of being refused a 403 on POST /configurations. This
# flag governs real providers only (OIDC, session tokens, the api_keys mapping):
# standalone mode always resolves to a concrete owner email — the default
# standalone@autotunex.local, or AUTOTUNEX_STANDALONE_EMAIL above — and its users
# row is provisioned regardless of this flag. Note this makes even a GET write on
# a caller's first request.
# AUTOTUNEX_AUTO_PROVISION_USERS=true

# Machine callers (monitors, CI, the tuning pipeline). Maps a key's SHA-256
# hex digest to its owner's email — never the raw key. Mint one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#   python -c "import hashlib,sys; print(hashlib.sha256(sys.argv[1].encode()).hexdigest())" <key>
# Add "api_key" to AUTOTUNEX_AUTH_PROVIDERS to enable this verifier.
# AUTOTUNEX_API_KEYS={"<sha256-digest>": "service@example.com"}

# OIDC bearer tokens (W3ID). All three are required together if "oidc" is in
# AUTOTUNEX_AUTH_PROVIDERS — there is no default, since the only discovery
# document on hand today is the *test* W3ID issuer, and a default pointing at
# it would be the worst possible production failure.
# AUTOTUNEX_OIDC_ISSUER=https://<real-issuer>
# AUTOTUNEX_OIDC_JWKS_URI=https://<real-issuer>/jwks
# AUTOTUNEX_OIDC_AUDIENCE=<your-client-id-or-whatever-a-real-access-token-carries-as-aud>
# See README.md's "OIDC bearer tokens" section for how to determine that value
# — it depends on whether W3ID's access tokens are JWTs, which is not
# documented and must be checked against a real token once.
#
# Signature algorithms accepted when verifying a bearer token. A JSON array,
# same rule as AUTOTUNEX_AUTH_PROVIDERS above.
# AUTOTUNEX_OIDC_ALGORITHMS=["RS256"]
# Claim names checked, in order, to resolve a token to an email.
# AUTOTUNEX_OIDC_EMAIL_CLAIMS=["email", "emailAddress"]
# Clock-skew tolerance (seconds) for exp/nbf checks.
# AUTOTUNEX_OIDC_LEEWAY_SECONDS=30

# ---------------------------------------------------------------------------
# Backend-for-frontend — browser sessions ("session" in AUTOTUNEX_AUTH_PROVIDERS)
# ---------------------------------------------------------------------------
# public_base_url has no trailing slash; redirect_uri is built as
# f"{public_base_url}/auth/callback" and is never taken from a request header.
# AUTOTUNEX_PUBLIC_BASE_URL=https://autotunex.example.com
# AUTOTUNEX_OIDC_CLIENT_ID=<your-client-id>
# AUTOTUNEX_OIDC_CLIENT_SECRET=<your-client-secret>
# AUTOTUNEX_OIDC_AUTHORIZATION_ENDPOINT=https://<real-issuer>/authorize
# AUTOTUNEX_OIDC_TOKEN_ENDPOINT=https://<real-issuer>/token
# AUTOTUNEX_OIDC_END_SESSION_ENDPOINT=https://<real-issuer>/logout
#
# session_secret has NO random fallback by design — an unset value refuses to
# start rather than mint sessions no other worker process can verify. It must
# also be at least 32 characters (RFC 7518 §3.2's own floor for an HS256 key);
# shorter values are rejected at startup. The command below yields 43:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# AUTOTUNEX_SESSION_SECRET=<generate one, keep it out of version control>
# AUTOTUNEX_SESSION_TTL_HOURS=8
#
# "lax" (default) if the UI is served from this same origin. "none" only if
# the UI is on a different origin — then AUTOTUNEX_CORS_ALLOW_ORIGINS is
# mandatory too.
# AUTOTUNEX_SESSION_COOKIE_SAME_SITE=lax
# AUTOTUNEX_CORS_ALLOW_ORIGINS=["https://ui.example.com"]

# ---------------------------------------------------------------------------
# LLM intelligence (Phase 2; optional)
# ---------------------------------------------------------------------------
# Powers the /datasets/intelligence endpoints (suggest parsing strategy,
# suggest column mapping). All three of BASE_URL, API_KEY and MODEL must be set
# together or none — a partial configuration refuses to start. All unset leaves
# the feature disabled: those endpoints return 503, while validate-strategy and
# GET /datasets/intelligence/formats keep working. Points at any
# OpenAI-compatible gateway (LiteLLM/vLLM/watsonx, or one fronting Claude); the
# adapter appends /chat/completions to the base URL. No provider-model default,
# deliberately. The API key is a secret — keep it out of version control.
# AUTOTUNEX_LLM_BASE_URL=https://your-gateway/v1
# AUTOTUNEX_LLM_API_KEY=<your-gateway-api-key>
# AUTOTUNEX_LLM_MODEL=<your-model-name>
# AUTOTUNEX_LLM_TIMEOUT_SECONDS=30.0
# AUTOTUNEX_LLM_MAX_RETRIES=2
# AUTOTUNEX_LLM_MAX_SAMPLE_BYTES=8000
# How to request JSON from the gateway: json_object (default; JSON mode, portable,
# works with Bedrock/Anthropic behind litellm), json_schema (strict OpenAI-style
# schema — Bedrock's Claude rejects it), or none (no response_format at all).
# AUTOTUNEX_LLM_STRUCTURED_OUTPUT=json_object

# ---------------------------------------------------------------------------
# Reward-function sandbox (online-RL reward step)
# ---------------------------------------------------------------------------
# Hard wall-clock + CPU budget (seconds) and address-space cap (bytes) for one
# sandboxed reward-function run. Enforced on Linux; the wall-clock kill always
# applies. Defaults: 5s, 512 MiB.
# AUTOTUNEX_REWARD_TIMEOUT_SECONDS=5
# AUTOTUNEX_REWARD_MEMORY_BYTES=536870912

# ---------------------------------------------------------------------------
# Chat assistant + MCP server
# ---------------------------------------------------------------------------
# The chat assistant reuses the LLM gateway above (AUTOTUNEX_LLM_*). Tool-calling
# quality matters: aws/claude-sonnet-4-6 is far more reliable at tool use than a
# flash-lite model. Set AUTOTUNEX_LLM_MODEL accordingly if chat tool use is flaky.
# AUTOTUNEX_CHAT_MAX_TOOL_ITERATIONS=8
# AUTOTUNEX_CHAT_THREAD_TTL_SECONDS=3600
# AUTOTUNEX_CHAT_MAX_THREADS=500

# Mount the standalone MCP server at /mcp for external MCP clients (Claude
# Desktop, Cursor). Needs: pip install -e ".[mcp]" AND "api_key" in
# AUTOTUNEX_AUTH_PROVIDERS for external callers to authenticate via X-API-Key.
# AUTOTUNEX_ENABLE_MCP=false

# Credentials for model hubs or object storage go here once those integrations
# exist. Keep them out of version control.
#
# Dataset storage: with AUTOTUNEX_DATASET_STORAGE_BACKEND=huggingface (or =auto,
# which picks HuggingFace when llmb and BOTH tokens are present), the uploader
# runs `llmb auth login --token <GB_TOKEN>` then `llmb artifact push ... --store
# hf` — so it needs BOTH GB_TOKEN (authenticates the llmb CLI; see
# AUTOTUNEX_GB_TOKEN_ENV above) and HF_TOKEN (the HuggingFace push destination).
# Neither value is read into Settings. Without both, storage falls back to local.
#
# Which storage backend to use: "auto" (default) → huggingface when llmb and
# BOTH tokens below are present, else local. "local" forces on-disk storage —
# this is what the `local` runner and the same-host `bash` runner read.
# "huggingface" forces the HF push — required for the remote custom_code and
# LSF/SkyPilot runners, which reference datasets by hf:// URI.
AUTOTUNEX_DATASET_STORAGE_BACKEND=auto
# In the same-host BASH standalone case (GB_ENVIRONMENT=standalone without
# AUTOTUNEX_LSF_CLUSTER) `llmb artifact push` is disabled, so `auto` and `local`
# store the dataset locally and emit an absolute file:// locator the build
# mounts as its dataset_files input; forcing `huggingface` there is refused at
# startup. The remote LSF/SkyPilot standalone variant (AUTOTUNEX_LSF_CLUSTER
# set) is unaffected by that refusal and still uses huggingface — a local
# file:// cannot reach the cluster, so HF-hosted data remains required there.
# Root directory for locally-stored dataset files. The `local` runner reads its
# training data from <dir>/<dataset_id>/<name>_<split>.<ext> here (local backend).
AUTOTUNEX_DATASET_STORAGE_DIR=artifacts/datasets
# Hard cap on a single uploaded dataset file, enforced while streaming (413
# once exceeded). Default is 5 GiB.
# AUTOTUNEX_DATASET_UPLOAD_MAX_BYTES=5368709120
# Max dataset uploads processed concurrently in-process; over-limit uploads
# queue on the slot rather than erroring (the 202 has already been returned).
# AUTOTUNEX_DATASET_UPLOAD_MAX_CONCURRENT=2
# Backstop timeout (seconds) for one dataset's off-request processing
# (count/split/remap/persist); on expiry the dataset is driven to `error`.
# AUTOTUNEX_DATASET_PROCESSING_TIMEOUT_SECONDS=3600
# Timeout (seconds) for each `llmb` subprocess (auth + artifact push) in the
# HuggingFace storage backend.
# AUTOTUNEX_DATASET_PUSH_TIMEOUT_SECONDS=1800
# Client-behaviour knobs surfaced to the frontend via GET /api/v1/app-config
# (the frontend has no other channel to learn them). Defaults shown.
# AUTOTUNEX_DATASET_CLIENT_GZIP_ENABLED=true
# AUTOTUNEX_DATASET_CLIENT_GZIP_MIN_BYTES=1048576
# AUTOTUNEX_DATASET_CLIENT_PARQUET_PREVIEW_MAX_BYTES=104857600
# Optional HF org/namespace prefix for the pushed dataset repo (huggingface backend).
# AUTOTUNEX_HF_NAMESPACE=your-org
# Name of the env var holding the HF token that `llmb build` reads (its value
# is never loaded into Settings — only checked for presence).
# AUTOTUNEX_HF_TOKEN_ENV=HF_TOKEN
# HF_TOKEN=
# GB_TOKEN=
#
# Dataset preview reads rows from the HuggingFace dataset viewer
# (datasets-server.huggingface.co) for HuggingFace-stored datasets, so a caller
# can preview a dataset that has no local copy. HF_TOKEN (above) must be present
# to preview a private repo. Defaults shown; all optional.
# AUTOTUNEX_HF_PREVIEW_ENABLED=true
# AUTOTUNEX_HF_VIEWER_BASE_URL=https://datasets-server.huggingface.co
# AUTOTUNEX_HF_VIEWER_TIMEOUT_SECONDS=2.5
# HuggingFace Hub API base URL used to list/download a job's output-model files
# for the result-report endpoint. Override for a mirror or a test double.
# AUTOTUNEX_HF_HUB_BASE_URL=https://huggingface.co
